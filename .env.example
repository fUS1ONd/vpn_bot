# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_id_here

# Web Server Port for Subscriptions
SUB_PORT=8000

# Subscription Host (domain or IP for subscription links)
# Links will be: http://{SUBSCRIPTION_HOST}:{SUB_PORT}/sub/{uuid}
# If empty, falls back to ServerA IP
SUBSCRIPTION_HOST=fus1ond.ru

# SQLite Web UI Port (optional, used with --profile tools)
SQLITE_WEB_PORT=8080

# Server A (Russia/Cascade) Configuration
SERVER_A_BASE_URL=https://your.server.a.ip:2053
SERVER_A_WEB_PATH=/your_web_path
SERVER_A_USERNAME=your_username
SERVER_A_PASSWORD=your_password
SERVER_A_INBOUND_ID=1
SERVER_A_LIMIT_BYTES=32212254720
SERVER_A_PUBLIC_KEY=your_public_key
SERVER_A_SNI=music.yandex.ru
SERVER_A_SID=your_sid

# Server B (Europe/Direct) Configuration
SERVER_B_BASE_URL=https://your.server.b.ip:2053
SERVER_B_WEB_PATH=/your_web_path
SERVER_B_USERNAME=your_username
SERVER_B_PASSWORD=your_password
SERVER_B_INBOUND_ID=1
SERVER_B_LIMIT_BYTES=0
SERVER_B_PUBLIC_KEY=your_public_key
SERVER_B_SNI=google.com
SERVER_B_SID=your_sid
