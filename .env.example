# VPN Bot Configuration (Remnawave v2)

# Telegram
BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_id_here

# ─────────────────────────────────────────────────────────────
# Юридические страницы и контакт поддержки
# Показываются в сообщении кнопки «Информация» (MsgInfo → BuildInfoMessage).
# Все три переменные ОБЯЗАТЕЛЬНЫ — бот не стартует без них.
# Меняются без пересборки: правишь .env → docker restart.
# ─────────────────────────────────────────────────────────────

# URL страницы политики конфиденциальности.
# Любой рабочий URL (telegra.ph, собственный сайт, Notion-страница и т. п.).
# Значение экранируется в HTML-атрибуте href, так что можно спокойно
# вставлять URL с query-параметрами.
# Пример: https://telegra.ph/Politika-konfidencialnosti-08-15-17
PRIVACY_POLICY_URL=https://example.com/privacy

# URL страницы пользовательского соглашения (оферты).
# Правила те же, что и для PRIVACY_POLICY_URL.
# Пример: https://telegra.ph/Polzovatelskoe-soglashenie-08-15-10
TERMS_OF_SERVICE_URL=https://example.com/terms

# Контакт поддержки, который подставляется в текст «Если есть вопросы — пишите ...».
# Значение ВСТАВЛЯЕТСЯ КАК ЕСТЬ (без экранирования), чтобы можно было положить
# готовую HTML-разметку. Варианты:
#   @fus1ond                                 — Telegram-логин
#   <a href="https://t.me/fus1ond">@fus1ond</a>  — кликабельная ссылка
#   support@example.com                      — email
# Ответственность за корректность HTML — на администраторе.
SUPPORT_CONTACT=@your_support_handle

# Remnawave API
REMNAWAVE_URL=https://panel.example.com
REMNAWAVE_API_TOKEN=your_jwt_token_here
REMNAWAVE_DEFAULT_SQUAD_UUIDS=uuid-1,uuid-2  # опционально, UUID internal squads через запятую; новые пользователи будут добавляться во все перечисленные сквады

# База данных
DB_PATH=/app/data/bot.db

# Мониторинг
SD_CONFIGS_PATH=/app/sd_configs
VICTORIA_METRICS_URL=http://victoriametrics:8428

# Субтитры (опционально)
RENDER_URL=http://render:8080
RENDER_API_KEY=your_render_api_key_here

# Платежи Platega (опционально)
PLATEGA_MERCHANT_ID=your_platega_merchant_id
PLATEGA_SECRET=your_platega_secret
PLATEGA_CALLBACK_URL=https://your-domain.example.com/platega/callback
CALLBACK_PORT=8080
MIN_SUBSCRIPTION_PRICE=400
# Единая цена новых referral-приглашений; фиксируется в ссылке при создании.
DEFAULT_SUBSCRIPTION_PRICE=400
# Необязательная тестовая цена для ADMIN_ID. Например, 10; без значения кнопка скрыта.
ADMIN_TEST_PAYMENT_PRICE=
PLATEGA_FEE_SBP=11
PLATEGA_FEE_CARD=12
PLATEGA_FEE_CRYPTO=5
PLATEGA_FEE_WITHDRAWAL=2

# ЮKassa (опционально; при совместном включении обслуживает рублёвые способы оплаты)
YOOKASSA_SHOP_ID=your_yookassa_shop_id
YOOKASSA_SECRET_KEY=your_yookassa_secret_key
YOOKASSA_RETURN_URL=https://t.me/your_bot
# Укажите фактическую ставку из договора с ЮKassa до production-включения.
YOOKASSA_FEE_PERCENT=3.5

# Триал
TRIAL_TRAFFIC_LIMIT_GB=1

# «Мой налог» — автопробитие чеков по платежам ЮKassa (опционально).
# Без ИНН и пароля бот работает как прежде, чеки не пробиваются.
MOYNALOG_INN=your_inn
MOYNALOG_PASSWORD=your_lknpd_password
# Базовая часть наименования услуги; бот приписывает к ней метку в скобках.
MOYNALOG_SERVICE_NAME=Sarvizza - Подписка на месяц

# Канал сообщества (опционально). Фича включается только при обеих переменных;
# если задана лишь одна из них, бот не стартует — это почти наверняка опечатка.
# Ссылку с одобрением заявок администраторами создайте руками, бота добавьте
# в супергруппу админом с правами одобрять заявки и банить участников.
COMMUNITY_CHAT_ID=-1001234567890
COMMUNITY_INVITE_LINK=https://t.me/+your_invite_link
