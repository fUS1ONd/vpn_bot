*.pyd
.Python

# Environment
# .env.* закрывает и .env.test: заполненный файл стенда несёт токен бота и
# ключи кассы, а оба Dockerfile делают COPY . . — иначе секреты запекались бы
# в builder-слой при каждой сборке.
.env
.env.*

# Database (will be mounted as volume)
# data-test/ перечислен отдельно: паттерн *.db в .dockerignore не переходит
# через «/» и вложенный data-test/bot.db не исключает.
*.db
data/
data-test/

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Documentation
README.md

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
