# Сборка заглушки панели для тестового стенда. В прод-образ не входит.
FROM golang:1.25-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o mockpanel ./cmd/mockpanel

FROM alpine:latest
WORKDIR /app
COPY --from=builder /build/mockpanel /app/mockpanel
CMD ["/app/mockpanel"]
