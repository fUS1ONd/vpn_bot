# Стенд для ручной проверки. Скопировать в .env.test и заполнить.
#
# ВНИМАНИЕ: и бот, и магазин здесь обязаны быть тестовыми. Боевой BOT_TOKEN
# перехватит апдейты у прод-бота, боевой магазин ЮKassa спишет живые деньги.

# Отдельный бот у @BotFather, НЕ боевой
BOT_TOKEN=
# Ваш Telegram ID: под ним доступна админка стенда
ADMIN_ID=

# Тестовый магазин ЮKassa (Личный кабинет → Тестовый магазин).
# Автоплатежи на тестовом магазине доступны по умолчанию, согласование не нужно.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/your_test_bot

# Юридические страницы: на стенде подойдут любые рабочие ссылки
PRIVACY_POLICY_URL=https://example.com/privacy
TERMS_OF_SERVICE_URL=https://example.com/terms
SUPPORT_CONTACT=@your_support

DEFAULT_SUBSCRIPTION_PRICE=400
MIN_SUBSCRIPTION_PRICE=400

# Контракт панели, который эмулирует заглушка: 2.8.1 или 3.2.3
MOCK_PANEL_VERSION=2.8.1

# Порт пульта заглушки на хосте (POST /mock/user — подкрутить срок и статус).
MOCK_PANEL_PORT=8081

AUTORENEW_ENABLED=true

# Порт callback-сервера на хосте. Нужен только если пробрасываете вебхуки
# ЮKassa снаружи (ngrok/cloudflared) — для скриншотов интерфейса не обязателен.
TEST_CALLBACK_PORT=8090
